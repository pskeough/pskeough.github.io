---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import ArticleItem from '../../components/ArticleItem.astro';

const entries = await getCollection('writing');

const categoryOrder = ['Major Works', 'Short Fiction', 'Essays & Poetry'] as const;
const folderForCategory: Record<(typeof categoryOrder)[number], string> = {
  'Major Works': 'major-works',
  'Short Fiction': 'short-fiction',
  'Essays & Poetry': 'essays-and-poetry',
};

const grouped = categoryOrder.map((category) => ({
  category,
  folder: folderForCategory[category],
  items: entries
    .filter((e) => e.data.category === category)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
}));
---

<MainLayout title="Writing | Patrick Keough">
  <h1 class="section-header">Writing</h1>
  <p class="text-ink-gray text-[1.05rem] max-w-[68ch] mb-12">
    Fiction, essays, and poetry. The long projects are a novel in revision and a travel
    collection in progress, and beneath them sits a set of completed short pieces with their
    full PDFs attached. Every word is human-written.
  </p>
  {
    grouped.map((group) => (
      <section class="mb-16">
        <h2 class="section-header">{group.category}</h2>
        {group.items.length === 0 ? (
          <p class="text-ink-gray italic">No entries yet.</p>
        ) : (
          <div class="max-w-4xl">
            {group.items.map((entry) => (
              <ArticleItem
                href={`/writing/${group.folder}/${entry.slug}`}
                title={entry.data.title}
                description={entry.data.description}
                meta={[
                  entry.data.genre ?? group.category,
                  ...(entry.data.status ? [entry.data.status] : []),
                ]}
              />
            ))}
          </div>
        )}
      </section>
    ))
  }
</MainLayout>
