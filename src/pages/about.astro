---
import fs from 'node:fs';
import path from 'node:path';
import { getEntry } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';

const entry = await getEntry('about', 'index');
const Content = entry ? (await entry.render()).Content : null;

const name = (entry?.data.title ?? 'Patrick Keough').replace(/^About\s+/i, '');

// Asset slots live in /public/about. The signature renders only when present,
// so dropping signature.png into that folder is all it takes to light it up.
const photoSrc = '/about/selfie.png';
const resumeSrc = '/about/Patrick_Keough_Resume.pdf';
const signatureSrc = '/about/P_vladimir_flourish.png';
const hasSignature = fs.existsSync(path.join(process.cwd(), 'public', signatureSrc));
---

<MainLayout title="About | Patrick Keough">
  <header class="about-profile mx-auto">
    <img class="profile-photo" src={photoSrc} alt={`Portrait of ${name}`} width="200" height="200" />
    <div class="profile-meta">
      <h1 class="font-display profile-name">{name}</h1>
      <p class="profile-tagline">Independent AI Evaluation Researcher &amp; Writer</p>
      {hasSignature && (
        <img class="profile-signature" src={signatureSrc} alt={`${name} signature`} />
      )}
      <div class="profile-actions">
        <a class="resume-btn" href={resumeSrc} target="_blank" rel="noopener">
          <span>View Résumé</span>
          <span class="resume-btn-meta">PDF</span>
        </a>
        <a class="resume-btn resume-btn-ghost" href={resumeSrc} download>
          <span>Download</span>
        </a>
      </div>
    </div>
  </header>

  <article class="prose-broadsheet mx-auto">
    {Content && <Content />}
  </article>
</MainLayout>
