---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import ArticleItem from '../components/ArticleItem.astro';
import ProjectCard from '../components/ProjectCard.astro';

const research = await getCollection('research');
const projects = await getCollection('projects');
const writing = await getCollection('writing');

const featuredResearch = [
  research.find((r) => r.slug === 'psychbench'),
  research.find((r) => r.slug === 'granularity-gap'),
  research.find((r) => r.slug === 'explanation-gap')
].filter((x): x is NonNullable<typeof x> => Boolean(x));

const featuredWritings = [
  writing.find((w) => w.slug === 'the-basilisk'),
  writing.find((w) => w.slug === 'the-second-tree')
].filter((x): x is NonNullable<typeof x> => Boolean(x));

const featuredProjects = [
  projects.find((p) => p.slug === 'ingenuity-readiness-evaluator'),
  projects.find((p) => p.slug === 'claudemind'),
  projects.find((p) => p.slug === 'mimesis-mcp')
].filter((x): x is NonNullable<typeof x> => Boolean(x));

const folderForCategory: Record<'Major Works' | 'Short Fiction' | 'Essays & Poetry', string> = {
  'Major Works': 'major-works',
  'Short Fiction': 'short-fiction',
  'Essays & Poetry': 'essays-and-poetry',
};

const arxivAuthorUrl = 'https://arxiv.org/search/?searchtype=author&query=Keough%2C+P+S';

const stats = [
  { value: '3', label: 'Solo-authored studies; two on arXiv', href: '/research' },
  { value: '28,800', label: 'Synthetic patients benchmarked against real epidemiology', href: '/research/psychbench' },
  { value: '8,830', label: 'Adversarial responses scored for sycophancy severity', href: '/research/granularity-gap' },
  { value: '8', label: 'Frontier LLMs audited, US and Chinese labs', href: '/research' },
  { value: '300,000+', label: 'Words of prose, written without AI', href: '/writing' },
];
---

<MainLayout title="Patrick Keough | AI Evaluation Researcher & Writer">
  <section class="grid md:grid-cols-[2fr_1fr] gap-16 mb-16">
    <div class="text-[1.25rem] md:text-[1.5rem] leading-[1.6]">
      I am an independent AI evaluation researcher in Sydney. The finding repeats across three
      solo-authored studies and more than 40,000 scored model observations: large language
      models that pass binary safety checks still flatter users, flatten the populations they
      simulate, and misreport the variables that drove their own outputs. Two of the three
      studies sit on arXiv as preprints, with code and full prompt sets public. I also write
      fiction and essays, none of it with AI.
    </div>
    <aside class="font-sans text-[0.9rem] text-ink-gray border-l border-ink-gray pl-8 md:pl-8">
      <p><strong>Focus Areas:</strong> LLM Evaluation, Sycophancy &amp; Demographic Bias Auditing, Explanation Faithfulness, AI-Assisted Tooling, Literary Fiction.</p>
      <p class="mt-6"><strong>Contact:</strong> <a href="mailto:pskeough@gmail.com" class="article-link">pskeough@gmail.com</a></p>
      <p class="mt-2"><strong>Profiles:</strong> <a href="https://github.com/pskeough" class="article-link">GitHub</a> &middot; <a href={arxivAuthorUrl} class="article-link">arXiv</a> &middot; <a href="https://linkedin.com/in/patrick-keough-b5b7a7261" class="article-link">LinkedIn</a> &middot; <a href="/about" class="article-link">About</a></p>
    </aside>
  </section>

  <section class="stat-strip mb-16" aria-label="Key figures">
    {stats.map((s) => (
      <a href={s.href} class="stat">
        <span class="stat-number">{s.value}</span>
        <span class="stat-label">{s.label}</span>
      </a>
    ))}
  </section>

  <section class="mb-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-x-12 gap-y-12">
      <!-- Research Column -->
      <div class="md:col-span-8 flex flex-col justify-between">
        <div>
          <h2 class="section-header !mt-0 !mb-6">Featured Research</h2>
          <div class="flex flex-col gap-8">
            {featuredResearch.map((item) => (
              <ArticleItem
                href={`/research/${item.slug}`}
                title={item.data.title}
                description={item.data.description}
                meta={[String(item.data.pubDate.getFullYear()), item.data.status ?? 'Research']}
              />
            ))}
          </div>
        </div>
        <div class="mt-8 sans-meta">
          <a href="/research" class="article-link">All research &rarr;</a>
        </div>
      </div>

      <!-- Writing Column -->
      <div class="md:col-span-4 flex flex-col justify-between md:border-l md:border-ink-gray/40 md:pl-12">
        <div>
          <h2 class="section-header !mt-0 !mb-6">Featured Writing</h2>
          <div class="flex flex-col gap-8">
            {featuredWritings.map((item) => (
              <ArticleItem
                href={`/writing/${folderForCategory[item.data.category]}/${item.slug}`}
                title={item.data.title}
                description={item.data.description}
                meta={[item.slug === 'the-basilisk' ? 'Novel' : 'Essay Collection']}
              />
            ))}
          </div>
        </div>
        <div class="mt-8 sans-meta">
          <a href="/writing" class="article-link">All writing &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="section-header !mt-0 !mb-6">Featured Projects</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {featuredProjects.map((item) => (
        <ProjectCard
          href={`/projects/${item.slug}`}
          title={item.data.title}
          description={item.data.description}
          techStack={item.data.techStack}
        />
      ))}
    </div>
    <div class="mt-6 sans-meta">
      <a href="/projects" class="article-link">All projects &rarr;</a>
    </div>
  </section>
</MainLayout>
