---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import ArticleItem from '../components/ArticleItem.astro';
import ProjectCard from '../components/ProjectCard.astro';

const research = await getCollection('research');
const projects = await getCollection('projects');
const writing = await getCollection('writing');

const featuredResearch = [
  research.find((r) => r.slug === 'granularity-gap'),
  research.find((r) => r.slug === 'psychbench')
].filter((x): x is NonNullable<typeof x> => Boolean(x));

const featuredWritings = [
  writing.find((w) => w.slug === 'the-basilisk'),
  writing.find((w) => w.slug === 'anderermensch')
].filter((x): x is NonNullable<typeof x> => Boolean(x));

const featuredProjects = [
  projects.find((p) => p.slug === 'tai-rag'),
  projects.find((p) => p.slug === 'styleclone-mcp'),
  projects.find((p) => p.slug === 'sonic-vector')
].filter((x): x is NonNullable<typeof x> => Boolean(x));
---

<MainLayout title="Patrick Keough | Portfolio">
  <section class="grid md:grid-cols-[2fr_1fr] gap-16 mb-16 pb-16 border-b border-ink-gray">
    <div class="text-[1.5rem] leading-[1.6]">
      I am an independent AI safety and red-team researcher, software builder, and novelist
      currently based in Sydney. My work investigates the socio-technical fault lines of
      artificial intelligence, alongside producing unassisted, clinical literary fiction.
    </div>
    <aside class="font-sans text-[0.9rem] text-ink-gray border-l border-ink-gray pl-8 md:pl-8">
      <p><strong>Focus Areas:</strong> LLM Alignment, Algorithmic Bias, AI-Assisted Tooling, Post-Apocalyptic Surrealism.</p>
      <br />
      <p><strong>Contact:</strong> <a href="mailto:pskeough@gmail.com" class="article-link">pskeough@gmail.com</a></p>
      <p class="mt-2"><strong>Profiles:</strong> <a href="https://github.com/pskeough" class="article-link">GitHub</a> &mdash; <a href="/research" class="article-link">arXiv</a> &mdash; <a href="/about" class="article-link">About</a></p>
    </aside>
  </section>

  <section class="mb-16">
    <!-- Headers -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-8">
        <h2 class="section-header !mt-0 !mb-6">Featured Research</h2>
      </div>
      <div class="md:col-span-4">
        <h2 class="section-header !mt-0 !mb-6">Featured Writing</h2>
      </div>
    </div>

    <!-- Items aligned by row -->
    {Array.from({ length: Math.max(featuredResearch.length, featuredWritings.length) }).map((_, i) => (
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-8">
          {featuredResearch[i] ? (
            <ArticleItem
              href={`/research/${featuredResearch[i].slug}`}
              title={featuredResearch[i].data.title}
              description={featuredResearch[i].data.description}
              meta={[String(featuredResearch[i].data.pubDate.getFullYear()), featuredResearch[i].data.pdfLink ? 'Preprint' : 'Paper']}
            />
          ) : <div />}
        </div>
        <div class="md:col-span-4">
          {featuredWritings[i] ? (
            <ArticleItem
              href={`/writing/${featuredWritings[i].slug}`}
              title={featuredWritings[i].data.title}
              description={featuredWritings[i].data.description}
              meta={[featuredWritings[i].data.category === 'Major Works' ? 'Novel' : featuredWritings[i].data.category]}
            />
          ) : <div />}
        </div>
      </div>
    ))}

    <!-- Footer Links -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-8 sans-meta">
        <a href="/research" class="article-link">All research &rarr;</a>
      </div>
      <div class="md:col-span-4 sans-meta">
        <a href="/writing" class="article-link">All writing &rarr;</a>
      </div>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="section-header !mt-0 !mb-6">Featured Projects</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredProjects.map((item) => (
        <ProjectCard
          href={`/projects/${item.slug}`}
          title={item.data.title}
          description={item.data.description}
          techStack={item.data.techStack}
        />
      ))}
    </div>
    <div class="mt-6 sans-meta">
      <a href="/projects" class="article-link">All projects &rarr;</a>
    </div>
  </section>
</MainLayout>
