---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import ArticleItem from '../../components/ArticleItem.astro';

const entries = (await getCollection('research')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999) ||
    b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<MainLayout title="Research & Audits | Patrick Keough">
  <h1 class="section-header">Research &amp; Audits</h1>
  <p class="text-ink-gray text-[1.05rem] max-w-[68ch] mb-12">
    Empirical audits of large language model behavior: sycophancy under social pressure,
    demographic bias in clinical simulation against real epidemiological baselines, and whether
    post-hoc explanations faithfully report the variables that actually drove a model's output.
    Two are arXiv preprints. Code and full prompt sets are public where the work allows it.
  </p>
  <div class="max-w-5xl">
    {
      entries.map((entry) => (
        <div class="grid grid-cols-1 md:grid-cols-[1fr_240px] gap-x-10 gap-y-4 items-start mb-4">
          <ArticleItem
            href={`/research/${entry.slug}`}
            title={entry.data.title}
            description={entry.data.description}
            meta={[String(entry.data.pubDate.getFullYear()), entry.data.status ?? 'Research']}
          />
          {entry.data.plate && (
            <a href={`/research/${entry.slug}`} class="plate mb-12 md:mb-0" tabindex="-1" aria-hidden="true">
              <figure>
                <img src={entry.data.plate} alt="" width="240" loading="lazy" />
                {entry.data.plateCaption && <figcaption>{entry.data.plateCaption}</figcaption>}
              </figure>
            </a>
          )}
        </div>
      ))
    }
  </div>
</MainLayout>
