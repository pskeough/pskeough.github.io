---
// A short self-hosted MP4 clip, muted and looping, played from its controls.
interface Props {
  src: string;
  caption: string;
  poster?: string;
}
const { src, caption, poster } = Astro.props;
---

<figure class="media-figure">
  <video src={src} poster={poster} controls muted loop playsinline preload="metadata"></video>
  <figcaption>{caption}</figcaption>
</figure>
