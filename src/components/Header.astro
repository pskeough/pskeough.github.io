---
const navItems = [
  { href: '/research', label: 'Research' },
  { href: '/writing', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="py-12 mb-16 border-b-[3px] border-ink flex flex-col md:flex-row md:justify-between md:items-end gap-6">
  <div>
    <a href="/" class="hover:!border-transparent">
      <h1 class="font-display text-5xl font-extrabold tracking-tight">Patrick Keough</h1>
    </a>
    <div class="sans-meta mt-2">Independent AI Researcher &amp; Writer &mdash; Sydney</div>
  </div>
  <nav class="flex gap-8 pb-2">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'font-sans text-[0.85rem] font-semibold uppercase tracking-wider',
            { 'border-b-2 border-ink hover:!border-ink': isActive(item.href) },
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
