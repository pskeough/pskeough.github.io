---
const navItems = [
  { href: '/research', label: 'Research' },
  { href: '/writing', label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const today = new Date().toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<header class="pt-12 pb-6 mb-12">
  <div class="masthead-rule pb-6 flex flex-col md:flex-row md:justify-between md:items-end gap-6">
    <div>
      <a href="/" class="hover:!border-transparent">
        {
          isHome ? (
            <h1 class="font-display text-4xl md:text-5xl font-extrabold tracking-tight">Patrick Keough</h1>
          ) : (
            <p class="font-display text-4xl md:text-5xl font-extrabold tracking-tight">Patrick Keough</p>
          )
        }
      </a>
    </div>
    <nav class="flex flex-wrap gap-x-8 gap-y-2 pb-1" aria-label="Primary">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'font-sans text-[0.85rem] font-semibold uppercase tracking-wider py-2',
              { 'border-b-2 border-ink hover:!border-ink': isActive(item.href) },
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="dateline-strip mt-3">
    <span>AI Evaluation Researcher &amp; Writer &middot; Sydney &middot; {today}</span>
  </div>
</header>
