---
// Tufte-style margin note. Renders in the right margin on wide viewports
// and as a bordered inline note below ~1280px. Use between paragraphs in MDX:
//   import MarginNote from '../../components/MarginNote.astro';
//   <MarginNote>Source detail or aside.</MarginNote>
---

<span class="margin-note" role="note"><slot /></span>
